{
  "workspace": [
    "./web/client",
    "./web/server",
    "./web/tests"
  ],
  "tasks": {
    "dev": "deno task --cwd web/server dev",
    "serve": "deno task --cwd web/server serve",
    "build": "deno task --cwd web/server build",
    "test": "deno test -P --ignore=web/tests",
    "test:browser": "deno task --cwd web/tests test",
    "lightpanda:install": {
      "description": "Download the lightpanda binary used by test:browser (a pinned release, not nightly)",
      "command": "deno run -A npm:@lightpanda/browser install 1.0.3"
    },
    "check": "deno task --cwd web/client check && deno task --cwd web/server check && deno lint && deno fmt --check"
  },
  "permissions": {
    "default": {
      "read": true,
      "env": true,
      "net": [
        "localhost",
        "127.0.0.1"
      ],
      "import": true
    }
  },
  "test": {
    "permissions": "default"
  },
  "nodeModulesDir": "auto",
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": [
      "jsr:@kuboon/*",
      "jsr:@remix-kbn/*",
      "npm:@remix-run/*"
    ]
  },
  "unstable": [
    "bundle"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@remix-run/component"
  },
  "imports": {
    "ruby-jsx/jsx-runtime": "./web/client/ruby/jsx_runtime.ts",
    "ruby-jsx/jsx-dev-runtime": "./web/client/ruby/jsx_runtime.ts",
    "@lightpanda/browser": "npm:@lightpanda/browser@^1.6.0",
    "@remix-kbn/assets-deno": "jsr:@remix-kbn/assets-deno@^0.9.0",
    "@remix-kbn/ssg": "jsr:@remix-kbn/ssg@^0.13.0",
    "@remix-run/component": "npm:@remix-run/component@^1.2.0",
    "@remix-run/fetch-router": "npm:@remix-run/fetch-router@^1.0.0",
    "@remix-run/render-middleware": "npm:@remix-run/render-middleware@^1.1.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "canvaskit-wasm": "npm:canvaskit-wasm@^0.40.0",
    "puppeteer-core": "npm:puppeteer-core@^23.11.1"
  },
  "fmt": {
    "exclude": [
      "web/dist",
      "node_modules"
    ]
  },
  "lint": {
    "exclude": [
      "web/dist",
      "node_modules"
    ]
  }
}
